# Copie para o ambiente/gerenciador de segredos; nunca versione valores reais.
DATABASE_URL=
# Gere um segredo aleatório com pelo menos 32 caracteres e cadastre somente no gerenciador de segredos.
AMAZONIA_AUTH_SECRET=
# Origens permitidas para chamadas da interface web.
AMAZONIA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URL pública da API consumida pelo frontend.
VITE_API_URL=http://localhost:8000

# Cookies seguros em produção; HTTPS obrigatório quando true.
AMAZONIA_COOKIE_SECURE=true
AMAZONIA_COOKIE_SAMESITE=none

# Account email verification and password recovery (required in deployed environments)
AMAZONIA_REQUIRE_EMAIL_VERIFICATION=true
AMAZONIA_WEB_URL=http://localhost:5173
AMAZONIA_OWNER_EMAIL=
AMAZONIA_SMTP_HOST=
AMAZONIA_SMTP_PORT=587
AMAZONIA_SMTP_USERNAME=
AMAZONIA_SMTP_PASSWORD=
AMAZONIA_EMAIL_FROM=
